+// Scene-cut guard for the LSFG frame generation: measures how different two frames are (GPU, one small
+// compute pass) and, above a threshold, shows the earlier real frame instead of the generated one.
+// GPL-3.0-or-later (with the rest of the LSFG code).
+#pragma once
+#include "lsfg_chain.h"
+#include "lsfg_shim.h"
+namespace Vulkan {
+constexpr u32 LSFG_CUT_SLOTS = 8;
+class LsfgCut {
+ public:
+  // frames: the chain's two input images; gen: the generated frame (image + sampled view, GENERAL layout)
+  LsfgCut(const Device& device, MemoryAllocator& allocator, LsfgChain& chain, VkExtent2D extent, VkFormat format,
+          VkImage gen, VkImageView genView, bool select);
+  // difference of Input(count-1) and Input(count), into slot count % LSFG_CUT_SLOTS
+  void RecordMetric(VkCommandBuffer cmd, u64 count);
+  // the picture to show between the two frames: image(), after this
+  void RecordSelect(VkCommandBuffer cmd, u64 count, VkImage gen, float threshold);
+  VkImage SelectedImage() const { return *sel; }
+  float Metric(u64 slotCount) const;  // may be a frame or two stale: for the log
+ private:
+  struct Push { u32 slot; float threshold; };
+  vk::Sampler sampler;
+  vk::Buffer metric;
+  vk::Image sel;
+  vk::ImageView selView;
+  vk::DescriptorPool pool;
+  vk::DescriptorSetLayout reduceSetLayout, selectSetLayout;
+  vk::PipelineLayout reduceLayout, selectLayout;
+  vk::ShaderModule reduceModule, selectModule;
+  vk::Pipeline reducePipeline, selectPipeline;
+  vk::DescriptorSets reduceSets, selectSets;
+  VkExtent2D extent{};
+  bool haveSelect = false;
+};
+}  // namespace Vulkan
