+// Reads the SPIR-V shaders out of the user's own Lossless.dll (PE resources, RCDATA).
+// Derived from Eden's video_core/frame_gen/{lossless_dll,lsfg_translate}.cpp
+// (Eden Emulator Project, lsfg-vk), GPL-3.0-or-later.
+#pragma once
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace lsfg {
+using ShaderModules = std::map<uint32_t, std::vector<uint32_t>>;  // id -> SPIR-V words
+constexpr uint32_t kMipmaps = 255, kGenerate = 256, kPerfFirst = 280, kPerfLast = 302;
+// 0 on success; otherwise a message in `error`
+bool load_shaders_from_dll(const std::string& path, ShaderModules& out, std::string& error);
+}  // namespace lsfg
