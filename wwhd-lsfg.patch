+#ifdef __PROSPERO__
+// PlayStation 5: in-between frames keep the step's shadow maps.
+//
+// At 60 fps every step of the game is drawn twice (frame interpolation: interp.cpp), each pass in
+// full. On the first island's pier that is 5,150 draws a pass, and 2,739 of them fill the shadow
+// maps: three 1024x1024 slices of one depth array, drawn with no colour target. The render thread
+// needs about 19 ms for such a pass, the two of a step do not fit in a thirtieth of a second, and
+// the game cannot run ahead of the render thread to make room (it reads guest memory as it draws).
+//
+// So on an in-between pass the draws into that depth array, and its clears (surfaces.cpp), are
+// left out: the maps of the step's first pass stay, 16 ms old for what moved. The array is the one
+// the last full pass drew into without a colour target (ps5ShadowDepth); which kind of pass this
+// is comes from the swap before it (gx2_core.cpp). WWHD_PS5_HOLD_SHADOWS=1 turns this on.
+static bool ps5HoldPass = false;
+static uint32_t ps5ShadowDepth = 0;
+static uint64_t ps5ShadowSkipped = 0;
+void ps5_set_hold_pass(bool hold) {
+  static uint64_t passes;
+  if (hold && ++passes % 3000 == 0 && preparation_stats_enabled())  // (WWHD_VK_STATS)
+    LOG("[vulkan] in-between passes: %llu so far, %.0f shadow-map draws left out of each (the maps at %08X)",
+        (unsigned long long)passes, double(std::exchange(ps5ShadowSkipped, 0)) / 3000.0, ps5ShadowDepth);
