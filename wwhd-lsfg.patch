+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+// SPDX-FileCopyrightText: Copyright 2025 lsfg-vk
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+
+#include "lsfg_shim.h"
+#include "lsfg_common.h"
+
+namespace Vulkan {
+
+class Device;
+class LsfgShaders;
+
+constexpr size_t LSFG_DELTA_STAGES = 10;
+constexpr size_t LSFG_DELTA_TEMPS = 3;
+
+class LsfgDelta {
+public:
+    LsfgDelta() = default;
+    LsfgDelta(const Device& device, MemoryAllocator& memory_allocator, const LsfgShaders& shaders,
+              LsfgResources& resources, vk::DescriptorPool& descriptor_pool,
+              LsfgImageHistory& inputs, LsfgImage& flow_input, LsfgImage* previous_gamma,
+              LsfgImage* previous1, LsfgImage* previous2);
+
+    void Dispatch(vk::CommandBuffer cmdbuf, u64 frame_count, size_t slot);
+
+    [[nodiscard]] LsfgImage& Output1() {
+        return out_image1;
+    }
+
+    [[nodiscard]] LsfgImage& Output2() {
+        return out_image2;
+    }
+
+private:
+    struct Generation {
+        std::array<VkDescriptorSet, LSFG_HISTORY_SLOTS> first_descriptor_sets{};
+        std::array<VkDescriptorSet, LSFG_HISTORY_SLOTS> sixth_descriptor_sets{};
+        std::array<VkDescriptorSet, LSFG_DELTA_STAGES - 2> descriptor_sets{};
+    };
+
+    LsfgImageHistory* inputs{};
+    LsfgImage* flow_input{};
+    LsfgImage* previous_gamma{};
+    LsfgImage* previous1{};
+    LsfgImage* previous2{};
+
+    std::array<LsfgPass, LSFG_DELTA_STAGES> passes;
+    std::array<Generation, LSFG_GENERATION_SLOTS> generations{};
+    vk::DescriptorSets owned_sets;
+
+    std::array<LsfgImage, LSFG_DELTA_TEMPS> temp1;
+    LsfgImagePair temp2;
+    LsfgImage out_image1;
+    LsfgImage out_image2;
+};
+
+} // namespace Vulkan
diff --git a/runtime/src/gfx/vulkan/lsfg_dll.cpp b/runtime/src/gfx/vulkan/lsfg_dll.cpp
new file mode 100644
index 0000000..90793a5
--- /dev/null
+++ b/runtime/src/gfx/vulkan/lsfg_dll.cpp
@@ -0,0 +1,119 @@
+// Derived from Eden Emulator Project / lsfg-vk, GPL-3.0-or-later.
+#include "lsfg_dll.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <span>
+#include <tuple>
+namespace lsfg {
+namespace {
+using u8 = uint8_t; using u16 = uint16_t; using u32 = uint32_t;
+struct Section { u32 va, vsize, raw, rsize; };
+struct Entry { u32 id, offset; bool dir, named; };
+struct Reader {
+  std::span<const u8> img;
+  template <class T> bool rd(size_t o, T& v) const {
+    if (o > img.size() || img.size() - o < sizeof(T)) return false;
+    std::memcpy(&v, img.data() + o, sizeof(T)); return true;
+  }
+};
+bool rva_to_off(const std::vector<Section>& s, u32 rva, size_t& out) {
+  for (auto& x : s) {
+    u32 span = std::max(x.vsize, x.rsize);
+    if (!span || rva < x.va) continue;
+    if (rva - x.va < span) { out = size_t(x.raw) + (rva - x.va); return true; }
+  }
+  return false;
+}
+bool entries(const Reader& r, size_t dir, std::vector<Entry>& out) {
+  u16 nn = 0, ni = 0;
+  if (!r.rd(dir + 12, nn) || !r.rd(dir + 14, ni)) return false;
+  out.clear();
+  for (size_t i = 0; i < size_t(nn) + ni; ++i) {
+    u32 name = 0, data = 0; size_t o = dir + 16 + i * 8;
+    if (!r.rd(o, name) || !r.rd(o + 4, data)) return false;
+    out.push_back({name & 0x7fffffffu, data & 0x7fffffffu, (data & 0x80000000u) != 0, (name & 0x80000000u) != 0});
+  }
+  return true;
+}
+// SPIR-V: renumber each module's bindings 0..n-1 in (set, binding) order (lsfg_translate)
+void renumber(std::vector<u32>& w) {
+  struct Slot { u32 set, binding; size_t at; };
+  std::map<u32, u32> sets; std::vector<Slot> slots;
+  size_t o = 5;
+  while (o + 1 <= w.size()) {
+    u32 len = w[o] >> 16, op = w[o] & 0xffff;
+    if (!len || o + len > w.size()) return;
+    if (op == 54) break;  // OpFunction
+    if (op == 71 && len >= 4) {  // OpDecorate
+      if (w[o + 2] == 34) sets[w[o + 1]] = w[o + 3];
+      else if (w[o + 2] == 33) slots.push_back({0, w[o + 3], o + 3});
+    }
+    o += len;
+  }
+  for (auto& s : slots) { auto h = sets.find(w[s.at - 2]); s.set = h == sets.end() ? 0 : h->second; }
+  std::stable_sort(slots.begin(), slots.end(), [](const Slot& a, const Slot& b) { return std::tie(a.set, a.binding) < std::tie(b.set, b.binding); });
+  for (size_t i = 0; i < slots.size(); ++i) w[slots[i].at] = u32(i);
+}
+}  // namespace
+
+bool load_shaders_from_dll(const std::string& path, ShaderModules& out, std::string& error) {
+  std::vector<u8> img;
+  { FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) { error = "cannot open " + path; return false; }
+    std::fseek(f, 0, SEEK_END); long n = std::ftell(f); std::fseek(f, 0, SEEK_SET);
+    img.resize(n > 0 ? size_t(n) : 0);
+    if (img.empty() || std::fread(img.data(), 1, img.size(), f) != img.size()) { std::fclose(f); error = "cannot read " + path; return false; }
+    std::fclose(f); }
+  Reader r{img};
+  u16 mz = 0; u32 pe = 0, sig = 0;
+  if (!r.rd(0, mz) || mz != 0x5A4D || !r.rd(0x3C, pe) || !r.rd(pe, sig) || sig != 0x4550) { error = "not a PE file"; return false; }
+  size_t opt = size_t(pe) + 4 + 20; u16 magic = 0;
+  if (!r.rd(opt, magic) || (magic != 0x10B && magic != 0x20B)) { error = "bad PE optional header"; return false; }
+  size_t dd = opt + (magic == 0x10B ? 96 : 112);
+  u16 nsec = 0, optsize = 0;
+  if (!r.rd(pe + 4 + 2, nsec) || !r.rd(pe + 4 + 16, optsize)) { error = "bad PE header"; return false; }
+  std::vector<Section> secs;
+  for (size_t i = 0; i < nsec; ++i) {
+    size_t o = pe + 4 + 20 + optsize + i * 40; Section s{};
+    if (!r.rd(o + 8, s.vsize) || !r.rd(o + 12, s.va) || !r.rd(o + 16, s.rsize) || !r.rd(o + 20, s.raw)) { error = "bad PE sections"; return false; }
+    secs.push_back(s);
+  }
+  u32 rrva = 0; size_t base = 0;
+  if (!r.rd(dd + 2 * 8, rrva) || !rrva || !rva_to_off(secs, rrva, base)) { error = "the DLL has no resources"; return false; }
+  std::vector<Entry> types;
+  if (!entries(r, base, types)) { error = "bad resource directory"; return false; }
+  std::map<u32, std::span<const u8>> res;
+  for (auto& t : types) {
+    if (t.named || t.id != 10 || !t.dir) continue;  // RCDATA
+    std::vector<Entry> names;
+    if (!entries(r, base + t.offset, names)) { error = "bad resource directory"; return false; }
+    for (auto& n : names) {
+      if (n.named || !n.dir) continue;
+      std::vector<Entry> langs;
+      if (!entries(r, base + n.offset, langs)) { error = "bad resource directory"; return false; }
+      for (auto& l : langs) {
+        if (l.dir) continue;
+        u32 rva = 0, size = 0; size_t leaf = base + l.offset, off = 0;
+        if (!r.rd(leaf, rva) || !r.rd(leaf + 4, size) || !size || !rva_to_off(secs, rva, off) || off > img.size() || img.size() - off < size) continue;
+        res[n.id] = std::span<const u8>(img.data() + off, size);
+        break;
+      }
+    }
+  }
+  std::vector<u32> ids{kMipmaps, kGenerate};
+  for (u32 i = kPerfFirst; i <= kPerfLast; ++i) ids.push_back(i);
+  out.clear();
+  for (u32 id : ids) {  // the native fp16 variants sit 49 ids higher
+    auto h = res.find(id + 49);
+    if (h == res.end()) { error = "shader " + std::to_string(id + 49) + " is missing: a different Lossless Scaling version?"; return false; }
+    auto b = h->second; u32 magic0 = 0;
+    if (b.size() < 20 || b.size() % 4) { error = "shader " + std::to_string(id + 49) + " is not SPIR-V"; return false; }
+    std::memcpy(&magic0, b.data(), 4);
+    if (magic0 != 0x07230203) { error = "shader " + std::to_string(id + 49) + " is not SPIR-V"; return false; }
+    std::vector<u32> w(b.size() / 4); std::memcpy(w.data(), b.data(), b.size());
+    renumber(w); out.emplace(id, std::move(w));
+  }
+  return true;
+}
+}  // namespace lsfg
