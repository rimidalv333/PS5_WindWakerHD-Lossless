+// GPL-3.0-or-later (uses passes derived from Eden Emulator Project / lsfg-vk)
+#include "lsfg_present.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <memory>
+#include <string>
+#include "../../interp.h"
+#include "../../runtime.h"
+#include <chrono>
+#include "lsfg_chain.h"
+#include "lsfg_cut.h"
+#include "lsfg_dll.h"
+#include "lsfg_shaders.h"
+#include "lsfg_shim.h"
+
+namespace gfxvk {
+LsfgDeviceSupport g_lsfgDevice;
+bool lsfg_requested() {
+  static const bool on = [] { const char* e = std::getenv("WWHD_PS5_LSFG"); return e && std::strcmp(e, "1") == 0; }();
+  return on;
+}
+namespace {
+using namespace Vulkan;
+namespace lv = Vulkan::vk;
+struct State {
+  bool failed = false, announced = false, warnedMode = false;
+  uint64_t count = 0;  // frames given to the chain since it was built
+  MemoryAllocator allocator;
+  Device device;
+  LsfgShaders shaders;
+  std::unique_ptr<LsfgChain> chain;
+  std::unique_ptr<LsfgCut> cut;  // after the chain: it uses the chain's images
+  bool statsOn = false, cutOn = false;
+  float cutThreshold = 0.f, logThreshold = 0.05f;
+  uint64_t statFrames = 0, lastEvent = 0, events = 0;
+  double statSum = 0, statMax = 0;
+  uint64_t hist[7] = {};
+  std::chrono::steady_clock::time_point started = std::chrono::steady_clock::now();
+  lv::Image gen;
+  lv::ImageView genView;
+  VkExtent2D extent{};
+  VkFormat format = VK_FORMAT_UNDEFINED;
+  std::unique_ptr<Surface> mid;
+  bool haveMid = false;
+};
+State& st() { static State s; return s; }
+
+bool exists(const std::string& p) { std::ifstream f(p, std::ios::binary); return f.good(); }
+std::string dll_path() {
+  if (const char* e = std::getenv("WWHD_PS5_LSFG_DLL"); e && *e) return e;
+  for (const char* c : {"Lossless.dll", "/app0/Lossless.dll", "/data/homebrew/PPSA99306/Lossless.dll", "/data/homebrew/PPSA99306/userdata/Lossless.dll"})
+    if (exists(c)) return c;
+  return "Lossless.dll";
+}
+float flow_scale() {
+  const char* e = std::getenv("WWHD_PS5_LSFG_FLOW");
+  float v = e && *e ? float(std::atof(e)) : 100.f;
+  return std::min(1.f, std::max(0.25f, v / 100.f));
+}
+void fail(State& s, const char* why) {
+  s.failed = true;
+  s.cut.reset();
+  s.chain.reset();
+  LOG("[lsfg] disabled: %s", why);
+}
+VkImageMemoryBarrier barrier(VkImage image, VkAccessFlags src, VkAccessFlags dst, VkImageLayout from, VkImageLayout to) {
+  VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+  b.srcAccessMask = src; b.dstAccessMask = dst; b.oldLayout = from; b.newLayout = to;
+  b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  b.image = image; b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  return b;
+}
+void copy_image(VkCommandBuffer cmd, VkImage src, VkImageLayout srcLayout, VkImage dst, VkImageLayout dstLayout, VkExtent2D e) {
+  VkImageCopy r{};
+  r.srcSubresource = r.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+  r.extent = {e.width, e.height, 1};
+  vkCmdCopyImage(cmd, src, srcLayout, dst, dstLayout, 1, &r);
+}
+
+bool build(State& s, Surface* scan) {
+  const VkFormat fmt = scan->fmt.pixel;
+  // the game's picture is RGBA8 sRGB (TV buffer 0x41A) or UNORM; the chain works on the raw 8-bit values, in a
+  // UNORM twin (storage images cannot be sRGB; copies between the two are raw)
+  const VkFormat chainFmt = fmt == VK_FORMAT_R8G8B8A8_SRGB ? VK_FORMAT_R8G8B8A8_UNORM : fmt == VK_FORMAT_B8G8R8A8_SRGB ? VK_FORMAT_B8G8R8A8_UNORM : fmt;
+  // (the PS5 build's picture is VK_FORMAT_A2B10G10R10_UNORM_PACK32, 64: any of these 32/64-bit colour formats works,
+  // the passes only sample it and the generated frame is written in the same format)
+  const bool supported = chainFmt == VK_FORMAT_R8G8B8A8_UNORM || chainFmt == VK_FORMAT_B8G8R8A8_UNORM ||
+                         chainFmt == VK_FORMAT_A2B10G10R10_UNORM_PACK32 || chainFmt == VK_FORMAT_A2R10G10B10_UNORM_PACK32 ||
+                         chainFmt == VK_FORMAT_R16G16B16A16_SFLOAT;
+  if (!supported) { LOG("[lsfg] picture format %d", int(fmt)); fail(s, "the picture format is not one the frame generation handles"); return false; }
+  if (!g_lsfgDevice.float16 || !g_lsfgDevice.storageExtended || !g_lsfgDevice.storageWriteNoFormat || !g_lsfgDevice.nullDescriptor) {
+    LOG("[lsfg] device lacks: %s%s%s%s", g_lsfgDevice.float16 ? "" : "shaderFloat16 ", g_lsfgDevice.storageExtended ? "" : "storageImageExtendedFormats ",
+        g_lsfgDevice.storageWriteNoFormat ? "" : "storageImageWriteWithoutFormat ", g_lsfgDevice.nullDescriptor ? "" : "robustness2.nullDescriptor ");
+    fail(s, "the GPU lacks features the frame-generation shaders need");
+    return false;
+  }
+  const auto& props = format_properties(chainFmt);
+  const VkFormatFeatureFlags need = VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+  if ((props.optimalTilingFeatures & need) != need) { fail(s, "the picture format cannot be a storage image"); return false; }
+  LsfgSetDevice(R.device, R.physicalDevice);
+  try {
+    lsfg::ShaderModules code; std::string err; const std::string path = dll_path();
+    if (!lsfg::load_shaders_from_dll(path, code, err)) { LOG("[lsfg] %s (looked for %s)", err.c_str(), path.c_str()); fail(s, "no usable Lossless.dll: put it beside env.txt or set WWHD_PS5_LSFG_DLL"); return false; }
+    s.shaders = LsfgShaders(s.device, code);
+    if (!s.shaders.IsValid()) { fail(s, "the shaders were rejected by the driver"); return false; }
+    s.extent = {scan->extent.width, scan->extent.height};
+    s.format = fmt;
+    const float flow = flow_scale();
+    s.chain = std::make_unique<LsfgChain>(s.device, s.allocator, s.shaders, s.extent, chainFmt, flow);
+    VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    ci.imageType = VK_IMAGE_TYPE_2D; ci.format = chainFmt; ci.extent = {s.extent.width, s.extent.height, 1};
+    ci.mipLevels = 1; ci.arrayLayers = 1; ci.samples = VK_SAMPLE_COUNT_1_BIT; ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+    ci.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT;
+    ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE; ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    s.gen = s.allocator.CreateImage(ci);
+    s.genView = CreateWrappedImageView(s.device, s.gen, chainFmt);
+    s.chain->SetTarget(s.device, 1, 0, 0, *s.genView);
+    // WWHD_PS5_LSFG_STATS=1 logs how different consecutive frames are; WWHD_PS5_LSFG_CUT=<x> shows the earlier
+    // real frame instead of a generated one when they differ by more than x (0..1, mean of the colour channels)
+    const char* st = std::getenv("WWHD_PS5_LSFG_STATS");
+    const char* ct = std::getenv("WWHD_PS5_LSFG_CUT");
+    const char* lg = std::getenv("WWHD_PS5_LSFG_LOGDIFF");
+    s.statsOn = st && std::strcmp(st, "1") == 0;
+    s.cutThreshold = ct && *ct ? float(std::atof(ct)) : 0.f;
+    s.cutOn = s.cutThreshold > 0.f;
+    if (lg && *lg) s.logThreshold = float(std::atof(lg));
+    s.statFrames = s.lastEvent = s.events = 0; s.statSum = s.statMax = 0; std::memset(s.hist, 0, sizeof s.hist);
+    if (s.statsOn || s.cutOn) {
+      s.cut = std::make_unique<LsfgCut>(s.device, s.allocator, *s.chain, s.extent, chainFmt, *s.gen, *s.genView, s.cutOn);
+      LOG("[lsfg] frame-difference measure on (stats %d, cut threshold %.3f)", int(s.statsOn), s.cutThreshold);
+    }
+    s.count = 0;
+    LOG("[lsfg] frame generation ready: %ux%u, picture format %d (chain %d), flow %.0f%%, shaders from %s", s.extent.width, s.extent.height, int(fmt), int(chainFmt), flow * 100, path.c_str());
+  } catch (const std::exception& e) {
+    LOG("[lsfg] setup failed: %s", e.what());
+    fail(s, "setup failed");
+    return false;
+  }
+  return true;
+}
+
+// the picture that goes on screen between two frames, as an ordinary surface the presenter can draw
+void ensure_mid(State& s, Surface* scan) {
+  if (s.mid && s.mid->extent.width == scan->extent.width && s.mid->extent.height == scan->extent.height && s.mid->fmt.pixel == scan->fmt.pixel) return;
+  if (s.mid) destroy_surface_image(s.mid.get());
+  s.mid = std::make_unique<Surface>();
+  Surface* d = s.mid.get();
+  d->width = scan->extent.width; d->height = scan->extent.height;
+  d->format = scan->format; d->fmt = scan->fmt; d->scale = 1;
+  create_surface_image(d, false);
+}
+}  // namespace
+
+std::unique_ptr<Surface>& lsfg_mid() { return st().mid; }
+
+bool lsfg_frame(Screen& screen) {
+  State& s = st();
+  s.haveMid = false;
+  if (s.failed) return false;
+  Surface* scan = screen.scan.get();
+  if (!scan || !scan->image) return false;
+  if (interp::mode() != 0) {  // 60 fps frame interpolation already makes the in-between frames
+    if (!s.warnedMode) { s.warnedMode = true; LOG("[lsfg] waiting: set the game to 30 fps (frame interpolation off) so frames can be generated"); }
+    s.count = 0;
+    return false;
+  }
+  s.warnedMode = false;
+  if (!s.chain || s.extent.width != scan->extent.width || s.extent.height != scan->extent.height || s.format != scan->fmt.pixel) {
+    if (s.chain) { vk_check(vkDeviceWaitIdle(R.device), "lsfg rebuild"); s.cut.reset(); s.chain.reset(); s.gen = lv::Image(); s.genView = lv::ImageView(); }
+    if (!build(s, scan)) return false;
+  }
+  try {
+    end_encoder();
+    transition_image(scan, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+    VkCommandBuffer cmd = command_buffer();
+    const u64 count = s.count++;
+    LsfgImage& in = s.chain->Input(count);
+    {
+      const std::array b{barrier(in.Handle(), VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, in.Layout(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL)};
+      vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, b.data());
+      copy_image(cmd, scan->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, in.Handle(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, s.extent);
+      const std::array a{barrier(in.Handle(), VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL)};
+      vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 1, a.data());
+      in.SetLayout(VK_IMAGE_LAYOUT_GENERAL);
+    }
+    if (count < 1) return false;
+    if (s.cut) {
+      s.cut->RecordMetric(cmd, count);
+      if (s.statsOn && count >= 4) {  // the value of a frame or two ago: the GPU wrote it by now (this is only the log)
+        const double m = s.cut->Metric(count - 3);
+        static const double edges[6] = {0.005, 0.01, 0.02, 0.05, 0.1, 0.2};
+        size_t b = 0; while (b < 6 && m >= edges[b]) ++b;
+        ++s.hist[b]; s.statSum += m; s.statMax = std::max(s.statMax, m); ++s.statFrames;
+        if (m >= s.logThreshold && count - s.lastEvent >= 3 && s.events < 600) {
+          s.lastEvent = count; ++s.events;
+          LOG("[lsfg] t=%.1fs frame %llu diff %.4f", std::chrono::duration<double>(std::chrono::steady_clock::now() - s.started).count(), (unsigned long long)(count - 3), m);
+        }
+        if (s.statFrames >= 300) {
+          LOG("[lsfg] diff over %llu frames: avg %.4f max %.4f | <.005 %llu <.01 %llu <.02 %llu <.05 %llu <.1 %llu <.2 %llu >=.2 %llu",
+              (unsigned long long)s.statFrames, s.statSum / double(s.statFrames), s.statMax, (unsigned long long)s.hist[0], (unsigned long long)s.hist[1],
+              (unsigned long long)s.hist[2], (unsigned long long)s.hist[3], (unsigned long long)s.hist[4], (unsigned long long)s.hist[5], (unsigned long long)s.hist[6]);
+          s.statFrames = 0; s.statSum = s.statMax = 0; std::memset(s.hist, 0, sizeof s.hist);
+        }
+      }
+    }
+    s.chain->DispatchShared(lv::CommandBuffer(cmd), count);
+    if (count < 2) return false;  // the chain needs two frames of history
+    s.chain->DispatchGeneration(lv::CommandBuffer(cmd), count, 1, 0, 0, *s.gen, s.extent);
+    VkImage shown = *s.gen;
+    if (s.cut && s.cutOn) { s.cut->RecordSelect(cmd, count, *s.gen, s.cutThreshold); shown = s.cut->SelectedImage(); }
+    ensure_mid(s, scan);
+    transition_image(s.mid.get(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+    cmd = command_buffer();
+    copy_image(cmd, shown, VK_IMAGE_LAYOUT_GENERAL, s.mid->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, s.extent);
+    mark_gpu_written(s.mid.get());
+    s.haveMid = true;
+    if (!s.announced) { s.announced = true; LOG("[lsfg] first generated frame"); }
+  } catch (const std::exception& e) {
+    LOG("[lsfg] %s", e.what());
+    fail(s, "frame generation failed");
+    return false;
+  }
+  return s.haveMid;
+}
+}  // namespace gfxvk
diff --git a/runtime/src/gfx/vulkan/lsfg_present.h b/runtime/src/gfx/vulkan/lsfg_present.h
new file mode 100644
index 0000000..2971f88
--- /dev/null
+++ b/runtime/src/gfx/vulkan/lsfg_present.h
@@ -0,0 +1,18 @@
+// Lossless Scaling frame generation (LSFG) for the PS5 build: renders at 30 fps and makes the frame
+// between two finished frames on the GPU instead of drawing the game's in-between pass.
+// Shaders: the user's own Lossless.dll. Passes derived from Eden Emulator / lsfg-vk (GPL-3.0-or-later).
+// WWHD_PS5_LSFG=1 turns it on; WWHD_PS5_LSFG_DLL=<path> (default: Lossless.dll beside env.txt),
+// WWHD_PS5_LSFG_FLOW=<percent> (default 100; lower is faster), WWHD_PS5_LSFG_MIX=0 draws nothing extra.
+#pragma once
+#include <memory>
+#include "backend.h"
+namespace gfxvk {
+bool lsfg_requested();
+// set by device creation (backend.cpp) from what the device offers and was asked for
+struct LsfgDeviceSupport { bool float16 = false, storageExtended = false, storageWriteNoFormat = false, nullDescriptor = false; };
+extern LsfgDeviceSupport g_lsfgDevice;
+// records the frame generation for the frame now in s.scan; true: lsfg_mid() holds the in-between frame,
+// to be presented before the frame in s.scan
+bool lsfg_frame(Screen& s);
+std::unique_ptr<Surface>& lsfg_mid();
+}  // namespace gfxvk
diff --git a/runtime/src/gfx/vulkan/lsfg_shaders.cpp b/runtime/src/gfx/vulkan/lsfg_shaders.cpp
new file mode 100644
index 0000000..3ba353b
--- /dev/null
+++ b/runtime/src/gfx/vulkan/lsfg_shaders.cpp
@@ -0,0 +1,17 @@
+#include "lsfg_shaders.h"
+namespace Vulkan {
+LsfgShaders::LsfgShaders(const Device&, const lsfg::ShaderModules& code) {
+  for (const auto& [id, words] : code) {
+    VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    ci.codeSize = words.size() * 4; ci.pCode = words.data();
+    VkShaderModule m = VK_NULL_HANDLE;
+    if (gfxvk::vkCreateShaderModule(LsfgDevice(), &ci, nullptr, &m) != VK_SUCCESS) { modules.clear(); return; }
+    modules.emplace(id, vk::ShaderModule(m));
+  }
+  valid = true;
+}
+VkShaderModule LsfgShaders::Get(u32 id) const {
+  auto h = modules.find(id);
+  return h == modules.end() ? VK_NULL_HANDLE : *h->second;
+}
+}  // namespace Vulkan
diff --git a/runtime/src/gfx/vulkan/lsfg_shaders.h b/runtime/src/gfx/vulkan/lsfg_shaders.h
new file mode 100644
index 0000000..1537473
--- /dev/null
+++ b/runtime/src/gfx/vulkan/lsfg_shaders.h
@@ -0,0 +1,17 @@
+// GPL-3.0-or-later (derived from Eden's lsfg_shaders)
+#pragma once
+#include <map>
+#include "lsfg_dll.h"
+#include "lsfg_shim.h"
+namespace Vulkan {
+class LsfgShaders {
+ public:
+  LsfgShaders() = default;
+  LsfgShaders(const Device& device, const lsfg::ShaderModules& code);
+  bool IsValid() const { return valid; }
+  VkShaderModule Get(u32 shader_id) const;
+ private:
+  std::map<u32, vk::ShaderModule> modules;
+  bool valid = false;
+};
+}  // namespace Vulkan
diff --git a/runtime/src/gfx/vulkan/lsfg_shim.cpp b/runtime/src/gfx/vulkan/lsfg_shim.cpp
new file mode 100644
index 0000000..a7e1a8b
--- /dev/null
+++ b/runtime/src/gfx/vulkan/lsfg_shim.cpp
@@ -0,0 +1,118 @@
+// See lsfg_shim.h. GPL-3.0-or-later (with the lsfg-vk derived passes).
+#include "lsfg_shim.h"
+namespace Vulkan {
+namespace {
+VkDevice g_device = VK_NULL_HANDLE;
+VkPhysicalDevice g_physical = VK_NULL_HANDLE;
+void check(VkResult r, const char* what) {
+  if (r != VK_SUCCESS) throw std::runtime_error(std::string("lsfg: ") + what + " failed (" + std::to_string(int(r)) + ")");
+}
+u32 memory_type(u32 bits, VkMemoryPropertyFlags want) {
+  VkPhysicalDeviceMemoryProperties p;
+  gfxvk::vkGetPhysicalDeviceMemoryProperties(g_physical, &p);
+  for (u32 i = 0; i < p.memoryTypeCount; ++i)
+    if ((bits & (1u << i)) && (p.memoryTypes[i].propertyFlags & want) == want) return i;
+  throw std::runtime_error("lsfg: no suitable memory type");
+}
+}  // namespace
+void LsfgSetDevice(VkDevice d, VkPhysicalDevice p) { g_device = d; g_physical = p; }
+VkDevice LsfgDevice() { return g_device; }
+
+vk::Image MemoryAllocator::CreateImage(const VkImageCreateInfo& info) {
+  VkImage image = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateImage(g_device, &info, nullptr, &image), "vkCreateImage");
+  VkMemoryRequirements req;
+  gfxvk::vkGetImageMemoryRequirements(g_device, image, &req);
+  VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+  ai.allocationSize = req.size;
+  ai.memoryTypeIndex = memory_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+  VkDeviceMemory mem = VK_NULL_HANDLE;
+  if (VkResult r = gfxvk::vkAllocateMemory(g_device, &ai, nullptr, &mem); r != VK_SUCCESS) {
+    gfxvk::vkDestroyImage(g_device, image, nullptr);
+    check(r, "vkAllocateMemory (image)");
+  }
+  check(gfxvk::vkBindImageMemory(g_device, image, mem, 0), "vkBindImageMemory");
+  return vk::Image(image, mem);
+}
+
+vk::Buffer MemoryAllocator::CreateBuffer(const VkBufferCreateInfo& info, MemoryUsage) {
+  VkBuffer buffer = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateBuffer(g_device, &info, nullptr, &buffer), "vkCreateBuffer");
+  VkMemoryRequirements req;
+  gfxvk::vkGetBufferMemoryRequirements(g_device, buffer, &req);
+  VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+  ai.allocationSize = req.size;
+  ai.memoryTypeIndex = memory_type(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+  VkDeviceMemory mem = VK_NULL_HANDLE;
+  if (VkResult r = gfxvk::vkAllocateMemory(g_device, &ai, nullptr, &mem); r != VK_SUCCESS) {
+    gfxvk::vkDestroyBuffer(g_device, buffer, nullptr);
+    check(r, "vkAllocateMemory (buffer)");
+  }
+  check(gfxvk::vkBindBufferMemory(g_device, buffer, mem, 0), "vkBindBufferMemory");
+  void* ptr = nullptr;
+  check(gfxvk::vkMapMemory(g_device, mem, 0, VK_WHOLE_SIZE, 0, &ptr), "vkMapMemory");
+  return vk::Buffer(buffer, mem, ptr, info.size);
+}
+
+vk::Sampler Device::Logical::CreateSampler(const VkSamplerCreateInfo& info) const {
+  VkSampler s = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateSampler(g_device, &info, nullptr, &s), "vkCreateSampler");
+  return vk::Sampler(s);
+}
+
+vk::ImageView CreateWrappedImageView(const Device&, vk::Image& image, VkFormat format) {
+  VkImageViewCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+  ci.image = *image; ci.viewType = VK_IMAGE_VIEW_TYPE_2D; ci.format = format;
+  ci.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  VkImageView v = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateImageView(g_device, &ci, nullptr, &v), "vkCreateImageView");
+  return vk::ImageView(v);
+}
+
+vk::DescriptorPool CreateWrappedDescriptorPool(const Device&, size_t max_descriptors, size_t max_sets,
+                                               std::initializer_list<VkDescriptorType> types) {
+  std::vector<VkDescriptorPoolSize> sizes;
+  for (VkDescriptorType t : types) sizes.push_back({t, u32(max_descriptors)});
+  VkDescriptorPoolCreateInfo ci{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+  ci.maxSets = u32(max_sets); ci.poolSizeCount = u32(sizes.size()); ci.pPoolSizes = sizes.data();
+  VkDescriptorPool p = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateDescriptorPool(g_device, &ci, nullptr, &p), "vkCreateDescriptorPool");
+  return vk::DescriptorPool(p);
+}
+
+vk::DescriptorSetLayout CreateWrappedDescriptorSetLayout(const Device&, std::span<const VkDescriptorType> types,
+                                                         VkShaderStageFlags stages) {
+  std::vector<VkDescriptorSetLayoutBinding> b(types.size());
+  for (size_t i = 0; i < types.size(); ++i) b[i] = {u32(i), types[i], 1, stages, nullptr};
+  VkDescriptorSetLayoutCreateInfo ci{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+  ci.bindingCount = u32(b.size()); ci.pBindings = b.data();
+  VkDescriptorSetLayout l = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateDescriptorSetLayout(g_device, &ci, nullptr, &l), "vkCreateDescriptorSetLayout");
+  return vk::DescriptorSetLayout(l);
+}
+
+vk::DescriptorSets CreateWrappedDescriptorSets(vk::DescriptorPool& pool, std::span<const VkDescriptorSetLayout> layouts) {
+  VkDescriptorSetAllocateInfo ai{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+  ai.descriptorPool = *pool; ai.descriptorSetCount = u32(layouts.size()); ai.pSetLayouts = layouts.data();
+  std::vector<VkDescriptorSet> sets(layouts.size());
+  check(gfxvk::vkAllocateDescriptorSets(g_device, &ai, sets.data()), "vkAllocateDescriptorSets");
+  return vk::DescriptorSets(std::move(sets));
+}
+
+vk::PipelineLayout CreateWrappedPipelineLayout(const Device&, vk::DescriptorSetLayout& layout) {
+  VkPipelineLayoutCreateInfo ci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+  ci.setLayoutCount = 1; ci.pSetLayouts = layout.address();
+  VkPipelineLayout l = VK_NULL_HANDLE;
+  check(gfxvk::vkCreatePipelineLayout(g_device, &ci, nullptr, &l), "vkCreatePipelineLayout");
+  return vk::PipelineLayout(l);
+}
+
+vk::Pipeline CreateWrappedComputePipeline(const Device&, vk::PipelineLayout& layout, VkShaderModule shader) {
+  VkComputePipelineCreateInfo ci{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+  ci.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_COMPUTE_BIT, shader, "main", nullptr};
