+// GPL-3.0-or-later (with the rest of the LSFG code)
+#include "lsfg_cut.h"
+#include "lsfg_cut_spv.h"
+namespace Vulkan {
+namespace {
+void check(VkResult r, const char* what) {
+  if (r != VK_SUCCESS) throw std::runtime_error(std::string("lsfg cut: ") + what + " failed (" + std::to_string(int(r)) + ")");
+}
+vk::ShaderModule module_of(const uint32_t* code, size_t words) {
+  VkShaderModuleCreateInfo ci{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+  ci.codeSize = words * 4; ci.pCode = code;
+  VkShaderModule m = VK_NULL_HANDLE;
+  check(gfxvk::vkCreateShaderModule(LsfgDevice(), &ci, nullptr, &m), "vkCreateShaderModule");
+  return vk::ShaderModule(m);
+}
+vk::PipelineLayout layout_with_push(VkDescriptorSetLayout set) {
+  VkPushConstantRange range{VK_SHADER_STAGE_COMPUTE_BIT, 0, 8};
+  VkPipelineLayoutCreateInfo ci{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+  ci.setLayoutCount = 1; ci.pSetLayouts = &set; ci.pushConstantRangeCount = 1; ci.pPushConstantRanges = &range;
+  VkPipelineLayout l = VK_NULL_HANDLE;
+  check(gfxvk::vkCreatePipelineLayout(LsfgDevice(), &ci, nullptr, &l), "vkCreatePipelineLayout");
+  return vk::PipelineLayout(l);
+}
+VkImageMemoryBarrier image_barrier(VkImage image, VkAccessFlags src, VkAccessFlags dst, VkImageLayout from, VkImageLayout to) {
+  VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+  b.srcAccessMask = src; b.dstAccessMask = dst; b.oldLayout = from; b.newLayout = to;
+  b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  b.image = image; b.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+  return b;
+}
+}  // namespace
+
+LsfgCut::LsfgCut(const Device& device, MemoryAllocator& allocator, LsfgChain& chain, VkExtent2D extent_, VkFormat format,
+                 VkImage, VkImageView genView, bool select)
+    : extent(extent_), haveSelect(select) {
+  VkSamplerCreateInfo sc{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+  sc.magFilter = sc.minFilter = VK_FILTER_LINEAR; sc.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+  sc.addressModeU = sc.addressModeV = sc.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+  sampler = device.GetLogical().CreateSampler(sc);
+
+  VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+  bi.size = LSFG_CUT_SLOTS * sizeof(float); bi.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT; bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+  metric = allocator.CreateBuffer(bi, MemoryUsage::Upload);
+  std::memset(metric.Mapped().data(), 0, metric.Mapped().size());
+
+  pool = CreateWrappedDescriptorPool(device, 16, 8, {VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE});
+  const std::array reduceTypes{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER};
+  reduceSetLayout = CreateWrappedDescriptorSetLayout(device, reduceTypes, VK_SHADER_STAGE_COMPUTE_BIT);
+  reduceLayout = layout_with_push(*reduceSetLayout);
+  reduceModule = module_of(gfxvk::lsfg_cut_spv::reduce, sizeof gfxvk::lsfg_cut_spv::reduce / 4);
+  reducePipeline = CreateWrappedComputePipeline(device, reduceLayout, *reduceModule);
+  const std::array<VkDescriptorSetLayout, 2> rl{*reduceSetLayout, *reduceSetLayout};
+  reduceSets = CreateWrappedDescriptorSets(pool, rl);
+
+  auto image_info = [&](VkImageView v) { return VkDescriptorImageInfo{*sampler, v, VK_IMAGE_LAYOUT_GENERAL}; };
+  const VkDescriptorBufferInfo mi{*metric, 0, VK_WHOLE_SIZE};
+  for (u32 p = 0; p < 2; ++p) {  // count % 2 == p: current frame is Input(p), the earlier one Input(1 - p)
+    const auto prev = image_info(chain.Input(1 - p).View()), cur = image_info(chain.Input(p).View());
+    std::array<VkWriteDescriptorSet, 3> w{};
+    for (u32 i = 0; i < 3; ++i) { w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w[i].dstSet = reduceSets[p]; w[i].dstBinding = i; w[i].descriptorCount = 1; }
+    w[0].descriptorType = w[1].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    w[0].pImageInfo = &prev; w[1].pImageInfo = &cur;
+    w[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; w[2].pBufferInfo = &mi;
+    gfxvk::vkUpdateDescriptorSets(LsfgDevice(), 3, w.data(), 0, nullptr);
+  }
+  if (!select) return;
+
+  VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+  ci.imageType = VK_IMAGE_TYPE_2D; ci.format = format; ci.extent = {extent.width, extent.height, 1};
+  ci.mipLevels = 1; ci.arrayLayers = 1; ci.samples = VK_SAMPLE_COUNT_1_BIT; ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+  ci.usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT; ci.sharingMode = VK_SHARING_MODE_EXCLUSIVE; ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+  sel = allocator.CreateImage(ci);
+  selView = CreateWrappedImageView(device, sel, format);
+  const std::array selectTypes{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE};
+  selectSetLayout = CreateWrappedDescriptorSetLayout(device, selectTypes, VK_SHADER_STAGE_COMPUTE_BIT);
+  selectLayout = layout_with_push(*selectSetLayout);
+  selectModule = module_of(gfxvk::lsfg_cut_spv::select, sizeof gfxvk::lsfg_cut_spv::select / 4);
+  selectPipeline = CreateWrappedComputePipeline(device, selectLayout, *selectModule);
+  const std::array<VkDescriptorSetLayout, 2> sl{*selectSetLayout, *selectSetLayout};
+  selectSets = CreateWrappedDescriptorSets(pool, sl);
+  const auto gen = image_info(genView);
+  const VkDescriptorImageInfo out{VK_NULL_HANDLE, *selView, VK_IMAGE_LAYOUT_GENERAL};
+  for (u32 p = 0; p < 2; ++p) {
+    const auto prev = image_info(chain.Input(1 - p).View());
+    std::array<VkWriteDescriptorSet, 4> w{};
+    for (u32 i = 0; i < 4; ++i) { w[i].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET; w[i].dstSet = selectSets[p]; w[i].dstBinding = i; w[i].descriptorCount = 1; }
+    w[0].descriptorType = w[1].descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    w[0].pImageInfo = &gen; w[1].pImageInfo = &prev;
+    w[2].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; w[2].pBufferInfo = &mi;
+    w[3].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE; w[3].pImageInfo = &out;
+    gfxvk::vkUpdateDescriptorSets(LsfgDevice(), 4, w.data(), 0, nullptr);
+  }
+}
+
+void LsfgCut::RecordMetric(VkCommandBuffer cmd, u64 count) {
+  const Push push{u32(count % LSFG_CUT_SLOTS), 0.f};
+  gfxvk::vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, *reducePipeline);
+  const VkDescriptorSet set = reduceSets[count % 2];
+  gfxvk::vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, *reduceLayout, 0, 1, &set, 0, nullptr);
+  gfxvk::vkCmdPushConstants(cmd, *reduceLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof push, &push);
+  gfxvk::vkCmdDispatch(cmd, 1, 1, 1);
+}
+
+void LsfgCut::RecordSelect(VkCommandBuffer cmd, u64 count, VkImage gen, float threshold) {
+  // the metric (storage buffer write) and the generated frame (storage image write) are read by the next pass
+  VkMemoryBarrier mem{VK_STRUCTURE_TYPE_MEMORY_BARRIER};
+  mem.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT; mem.dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  const std::array img{image_barrier(gen, VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_READ_BIT, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL),
+                       image_barrier(*sel, 0, VK_ACCESS_SHADER_WRITE_BIT, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL)};
+  gfxvk::vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 1, &mem, 0, nullptr, u32(img.size()), img.data());
+  const Push push{u32(count % LSFG_CUT_SLOTS), threshold};
+  gfxvk::vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, *selectPipeline);
+  const VkDescriptorSet set = selectSets[count % 2];
+  gfxvk::vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, *selectLayout, 0, 1, &set, 0, nullptr);
+  gfxvk::vkCmdPushConstants(cmd, *selectLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof push, &push);
+  gfxvk::vkCmdDispatch(cmd, (extent.width + 7) / 8, (extent.height + 7) / 8, 1);
+  const std::array after{image_barrier(*sel, VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL)};
+  gfxvk::vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, u32(after.size()), after.data());
+}
+
+float LsfgCut::Metric(u64 count) const {
+  float v;
+  std::memcpy(&v, metric.Mapped().data() + (count % LSFG_CUT_SLOTS) * sizeof(float), sizeof v);
+  return v;
+}
+}  // namespace Vulkan
