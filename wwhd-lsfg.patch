+//
+// The buffers that are rewritten every frame (skinned models) bypass the buffer cache, and every
+// draw from one copied its range again: the snapshot reuse above compares the whole range with
+// guest memory first, which costs what the copy does. On the first island's pier that was 8.8 MiB
+// copied a frame for 1.7 MiB of different data: each buffer is drawn about five times (shadow,
+// depth, colour passes).
+//
+// What makes one copy enough is the contract the render thread already relies on: it reads guest
+// memory when it executes a draw, some time after the game issued it, and the game waits for it at
+// GX2DrawDone before writing those buffers again (gx2_core.cpp, render_sync). So a range copied in
+// an interval is good until the interval ends, unless the game says it wrote it: GX2Invalidate
+// (in order with the draws), or a cache flush or a write fault the write tracker saw. An entry
+// also ends with its submission, as the upload slice does, and sixteen bytes are compared as a
+// tripwire. WWHD_PS5_VERTEX_INTERVAL=0 turns it off.
+} // namespace
+uint64_t ps5VertexInterval = 1;
+namespace {
+struct Ps5VertexEntry {
+  uint64_t interval = 0, generation = 0, watch = 0;
+  uint32_t address = 0, size = 0, begin = 0, length = 0, invalidated = 0;
+  bool window = false;
+  uint8_t head[16];
+  UploadSlice slice;
+};
+std::array<Ps5VertexEntry, 2048> ps5VertexEntries;
+std::vector<uint32_t> ps5InvalidateStamp;  // per 4 KiB of guest memory: the invalidation that last touched it
+uint32_t ps5InvalidateClock = 1;
+uint64_t ps5VertexReused = 0, ps5VertexReusedBytes = 0, ps5VertexCopied = 0;
+bool ps5_vertex_interval_enabled() {
+  static const bool on = [] { const char* e = std::getenv("WWHD_PS5_VERTEX_INTERVAL"); return !e || std::strcmp(e, "0") != 0; }();
+  return on;
+}
+Ps5VertexEntry& ps5_vertex_entry(uint32_t address, uint32_t size, uint32_t begin, uint32_t length, bool window) {
+  uint64_t h = (uint64_t(address) * 0x9E3779B97F4A7C15ull) ^ (uint64_t(size) << 20) ^ (uint64_t(begin) << 7) ^ length ^ uint64_t(window);
+  h ^= h >> 29;
+  return ps5VertexEntries[size_t(h * 0xBF58476D1CE4E5B9ull >> 53)];  // 11 bits
+}
+bool ps5_vertex_reuse(uint32_t address, uint32_t size, uint32_t begin, uint32_t length, bool window, UploadSlice& out) {
+  const Ps5VertexEntry& e = ps5_vertex_entry(address, size, begin, length, window);
+  if (e.interval != ps5VertexInterval || e.generation != R.submissionGeneration || e.address != address ||
+      e.size != size || e.begin != begin || e.length != length || e.window != window)
+    return false;
+  if (!ps5InvalidateStamp.empty())
+    for (uint64_t page = (uint64_t(address) + begin) >> 12, last = (uint64_t(address) + begin + length - 1) >> 12; page <= last; ++page)
+      if (ps5InvalidateStamp[page] > e.invalidated) return false;
+  if (wwatch::changed_since(address + begin, length, e.watch)) return false;
+  if (std::memcmp(mem::ptr(address + begin), e.head, std::min<uint32_t>(length, sizeof e.head))) return false;
+  ++ps5VertexReused;
+  ps5VertexReusedBytes += length;
+  out = e.slice;
+  return true;
+}
+void ps5_vertex_remember(uint32_t address, uint32_t size, uint32_t begin, uint32_t length, bool window, uint64_t watch,
+                         const UploadSlice& slice) {
+  Ps5VertexEntry& e = ps5_vertex_entry(address, size, begin, length, window);
+  e.interval = ps5VertexInterval; e.generation = R.submissionGeneration; e.watch = watch;
+  e.address = address; e.size = size; e.begin = begin; e.length = length; e.window = window;
+  e.invalidated = ps5InvalidateClock;
+  std::memcpy(e.head, mem::ptr(address + begin), std::min<uint32_t>(length, sizeof e.head));
