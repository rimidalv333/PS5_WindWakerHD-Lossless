+vk::DescriptorSets CreateWrappedDescriptorSets(vk::DescriptorPool& pool, std::span<const VkDescriptorSetLayout> layouts);
+vk::PipelineLayout CreateWrappedPipelineLayout(const Device& device, vk::DescriptorSetLayout& layout);
